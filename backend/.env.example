# Meta Model API key. Required - without it the API returns a clear error
# instead of a fabricated plan. Never commit a real key; this file is a
# template only.
#
# Export it in your shell before `dotnet run` picks it up (Program.cs reads
# it directly via Environment.GetEnvironmentVariable, overriding anything in
# appsettings.json):
#
#   export META_MODEL_API_KEY="your-key-here"
META_MODEL_API_KEY=
